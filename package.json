{
  "name": "spiced",
  "version": "0.1.0",
  "private": true,
  "description": "A modular quality-of-life foundation for Spicetify.",
  "type": "module",
  "engines": { "node": ">=22.16" },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch --install",
    "watch": "node scripts/build.mjs --watch",
    "preview": "npm run build && node scripts/preview.mjs",
    "local:install": "npm run build && node scripts/install.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
